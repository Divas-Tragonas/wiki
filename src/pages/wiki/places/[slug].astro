---
import EntryLayout from '../../../layouts/EntryLayout.astro';
import { getCollection, render } from 'astro:content';
import { PLACE_TYPE_LABEL, routes } from '../../../lib/site';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.name}
  description={entry.data.description}
  breadcrumbs={[
    { label: 'Wiki', href: routes.wiki },
    { label: 'Llocs', href: routes.places },
    { label: entry.data.name },
  ]}
  metadata={[{ label: 'Tipus', value: PLACE_TYPE_LABEL[entry.data.type] }]}
  tags={entry.data.tags}
>
  <Content />
</EntryLayout>
