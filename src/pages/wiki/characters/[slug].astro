---
import EntryLayout from '../../../layouts/EntryLayout.astro';
import { getCollection, render } from 'astro:content';
import { CHARACTER_TYPE_LABEL, routes, STATUS_LABEL } from '../../../lib/site';

export async function getStaticPaths() {
  const characters = await getCollection('characters');
  return characters.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/* dels PCs només es mostra la informació identificativa; la fitxa és del jugador */
const metadata = [
  d.role && { label: 'Rol', value: d.role },
  d.pc && d.player && { label: 'Jugador', value: d.player },
  d.pc && d.race && { label: 'Raça', value: d.race },
  d.pc && d.pcClass && { label: 'Classe', value: d.pcClass },
  d.pc && d.level !== undefined && { label: 'Nivell', value: String(d.level) },
  d.type && { label: 'Tipus', value: CHARACTER_TYPE_LABEL[d.type] },
  d.cr && { label: 'CR', value: d.cr },
  { label: 'Estat', value: STATUS_LABEL[d.status] },
].filter((item) => !!item);
---

<EntryLayout
  title={d.name}
  description={d.description}
  breadcrumbs={[
    { label: 'Wiki', href: routes.wiki },
    { label: 'Personatges', href: routes.characters },
    { label: d.name },
  ]}
  metadata={metadata}
  tags={d.tags}
  showImage
  image={d.image}
>
  <Content />
</EntryLayout>
