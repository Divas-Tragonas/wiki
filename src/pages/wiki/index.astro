---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { byName, PLACE_TYPE_LABEL, routes } from '../../lib/site';

const all = (await getCollection('characters')).sort(byName);
const players = all.filter((c) => c.data.pc);
const characters = all.filter((c) => !c.data.pc);
const places = (await getCollection('places')).sort(byName);

/* PNJs que es veuen d'entrada (ha de coincidir amb el :nth-child de l'estil); la resta surten amb «Mostra'ls tots» */
const CHAR_BATCH = 6;
const PLACES_PREVIEW = 3;
---

<BaseLayout title="Wiki" description="Personatges i llocs de La Mina Perduda del Phentanilo">
  <div class="page">
    <PageHeader title="Wiki" description="Tota la informació sobre el món de la campanya: personatges jugadors, PNJs i llocs." />

    {players.length > 0 && (
      <section class="wiki-section">
        <SectionHeader title="Personatges jugadors" icon="⚔️" count={players.length} />
        <div class="cards-grid">
          {players.map((pc) => (
            <Card title={pc.data.name} description={pc.data.description} href={routes.character(pc.id)} tags={pc.data.tags.slice(0, 2)} />
          ))}
        </div>
      </section>
    )}

    <section class="wiki-section">
      <SectionHeader title="Personatges" icon="🧑" count={characters.length} link={{ href: routes.characters, label: 'Veure tots →' }} />
      <div class="cards-grid chars" data-collapsed={characters.length > CHAR_BATCH ? '' : undefined}>
        {characters.map((c) => (
          <Card title={c.data.name} description={c.data.description} href={routes.character(c.id)} tags={c.data.tags.slice(0, 2)} />
        ))}
      </div>
      {characters.length > CHAR_BATCH && (
        <button type="button" class="load-more-btn" id="chars-load-more">
          <span aria-hidden="true">+</span> Mostra'ls tots ({characters.length})
        </button>
      )}
    </section>

    <section class="wiki-section">
      <SectionHeader title="Llocs" icon="🗺" count={places.length} link={{ href: routes.places, label: 'Veure tots →' }} />
      <div class="cards-grid">
        {places.slice(0, PLACES_PREVIEW).map((place) => (
          <Card
            title={place.data.name}
            description={place.data.description}
            href={routes.place(place.id)}
            tags={place.data.tags.slice(0, 2)}
            badge={PLACE_TYPE_LABEL[place.data.type]}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const btn = document.getElementById('chars-load-more');
  btn?.addEventListener('click', () => {
    document.querySelector('.chars')?.removeAttribute('data-collapsed');
    btn.remove();
  });
</script>

<style>
  .wiki-section {
    margin-bottom: 3rem;
  }
  /* n + 7: a partir del PNJ CHAR_BATCH + 1, amagats fins que es despleguen */
  .chars[data-collapsed] > :global(:nth-child(n + 7)) {
    display: none;
  }
  .load-more-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 1.25rem auto 0;
    padding: 0.6rem 1.75rem;
    background-color: transparent;
    border: 1px solid var(--color-gold-500);
    border-radius: 9999px;
    color: var(--color-gold-500);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .load-more-btn:hover {
    background-color: var(--gold-hover);
    color: var(--color-gold-400);
  }
</style>
