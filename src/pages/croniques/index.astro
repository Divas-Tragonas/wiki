---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getCollection } from 'astro:content';
import { bySessionDesc, formatDate, routes } from '../../lib/site';

const croniques = (await getCollection('croniques')).sort(bySessionDesc);
---

<BaseLayout title="Cròniques" description="Les cròniques de les sessions de La Mina Perduda del Phentanilo">
  <div class="page narrow">
    <PageHeader title="Cròniques" description="El registre de les sessions de joc, en ordre cronològic invers." />

    <div class="sessions-list">
      {croniques.map(({ id, data }) => (
        <a href={routes.cronica(id)} class="session-card">
          <div class="session-number">Sessió {data.session}</div>
          <div>
            <h2 class="session-title">{data.title}</h2>
            <p class="session-summary">{data.summary}</p>
            <div class="session-meta">
              <span>{formatDate(data.date)}</span>
              {data.players.length > 0 && <span>{data.players.join(', ')}</span>}
            </div>
            {data.tags.length > 0 && (
              <div class="session-tags">
                {data.tags.map((tag) => <TagBadge tag={tag} />)}
              </div>
            )}
          </div>
          <span class="session-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .sessions-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .session-card {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: start;
    padding: 1.25rem;
    background-color: var(--color-stone-800);
    border: 1px solid var(--color-stone-700);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .session-card:hover {
    border-color: var(--color-gold-500);
    transform: translateX(4px);
  }
  .session-number {
    font-family: var(--font-display);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold-500);
    padding-top: 0.2rem;
    line-height: 1.4;
  }
  .session-title {
    font-size: 1.1rem;
    color: var(--color-gold-400);
    margin: 0 0 0.375rem 0;
  }
  .session-summary {
    font-size: 0.875rem;
    color: var(--color-parchment);
    opacity: 0.75;
    margin: 0 0 0.75rem 0;
    line-height: 1.5;
  }
  .session-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-parchment);
    opacity: 0.5;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }
  .session-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .session-arrow {
    color: var(--color-gold-500);
    opacity: 0.4;
    font-size: 1.125rem;
    padding-top: 0.125rem;
    transition: opacity 0.2s, transform 0.2s;
  }
  .session-card:hover .session-arrow {
    opacity: 1;
    transform: translateX(4px);
  }
</style>
