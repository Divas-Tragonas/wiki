---
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, routes, sessionTitle } from '../../lib/site';

export async function getStaticPaths() {
  const croniques = await getCollection('croniques');
  return croniques.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { session, date, summary, players, tags, vod } = entry.data;
---

<EntryLayout
  title={sessionTitle(entry)}
  description={summary}
  breadcrumbs={[
    { label: 'Cròniques', href: routes.croniques },
    { label: `Sessió ${session}` },
  ]}
  metadata={[
    { label: 'Sessió', value: String(session) },
    { label: 'Data', value: formatDate(date) },
    ...(players.length ? [{ label: 'Jugadors', value: players.join(', ') }] : []),
    ...(vod ? [{ label: 'Vídeo', value: vod.includes('youtu') ? 'YouTube' : 'Twitch', href: vod }] : []),
  ]}
  tags={tags}
>
  <Content />
</EntryLayout>
