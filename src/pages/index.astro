---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { lastModified } from '../lib/git';
import { formatDate, PLACE_TYPE_LABEL, routes, SITE_DESCRIPTION, SITE_NAME, sessionTitle } from '../lib/site';

const [croniques, characters, places] = await Promise.all([
  getCollection('croniques'),
  getCollection('characters'),
  getCollection('places'),
]);

function latestBy<T>(entries: T[], keyOf: (entry: T) => number | Date): T {
  return entries.reduce((latest, entry) => (keyOf(entry) > keyOf(latest) ? entry : latest));
}

const latestSession = latestBy(croniques, (c) => c.data.session);
const latestCharacter = latestBy(characters, (c) => lastModified(c.filePath));
const latestPlace = latestBy(places, (p) => lastModified(p.filePath));

const stats = [
  { value: characters.length, label: 'Personatges' },
  { value: places.length, label: 'Llocs' },
  { value: croniques.length, label: 'Sessions' },
];
---

<BaseLayout title="Inici" description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">Campanya de D&D 5e</p>
      <h1 class="hero-title">{SITE_NAME}</h1>
      <p class="hero-tagline">
        Seguiu les aventures d'un grup d'aventurers que es fan un lloc a Phentanil,
        enfrontant-se a la Vaina Roja i als perills que amaga la regió.
      </p>
      <div class="hero-buttons">
        <a href={routes.wiki} class="btn-primary">Explorar la Wiki</a>
        <a href={routes.croniques} class="btn-secondary">Llegir Cròniques</a>
        <a href={routes.missions} class="btn-secondary">Tauler de missions</a>
      </div>
    </div>
  </section>

  <section class="stats-section">
    <div class="stats-inner">
      {stats.map((stat, i) => (
        <>
          {i > 0 && <div class="stat-divider" />}
          <div class="stat-item">
            <span class="stat-number">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        </>
      ))}
    </div>
  </section>

  <section class="page recent-section">
    <SectionHeader title="Últims Canvis" />
    <div class="cards-grid">
      <Card
        title={sessionTitle(latestSession)}
        description={latestSession.data.summary}
        href={routes.cronica(latestSession.id)}
        tags={latestSession.data.tags.slice(0, 3)}
        badge={formatDate(latestSession.data.date)}
      />
      <Card
        title={latestCharacter.data.name}
        description={latestCharacter.data.description}
        href={routes.character(latestCharacter.id)}
        tags={latestCharacter.data.tags}
      />
      <Card
        title={latestPlace.data.name}
        description={latestPlace.data.description}
        href={routes.place(latestPlace.id)}
        tags={latestPlace.data.tags}
        badge={PLACE_TYPE_LABEL[latestPlace.data.type]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-stone-950) 0%, var(--color-stone-900) 100%);
    border-bottom: 1px solid var(--color-stone-700);
    padding: 5rem 1.5rem 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgb(201 168 76 / 0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    max-width: 52rem;
    margin: 0 auto;
    position: relative;
  }
  .hero-eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold-500);
    margin: 0 0 1rem 0;
  }
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    color: var(--color-gold-400);
    margin: 0 0 1.25rem 0;
    line-height: 1.1;
    text-shadow: 0 0 60px rgb(232 197 106 / 0.2);
  }
  .hero-tagline {
    font-size: 1.05rem;
    color: var(--color-parchment);
    opacity: 0.75;
    max-width: 36rem;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary,
  .btn-secondary {
    padding: 0.75rem 1.75rem;
    border: 1px solid var(--color-gold-500);
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: background-color 0.2s, color 0.2s;
  }
  .btn-primary {
    background-color: var(--color-gold-500);
    color: var(--color-stone-950);
  }
  .btn-primary:hover {
    background-color: var(--color-gold-400);
  }
  .btn-secondary {
    background-color: transparent;
    color: var(--color-gold-500);
  }
  .btn-secondary:hover {
    background-color: var(--gold-hover);
    color: var(--color-gold-400);
  }
  .stats-section {
    background-color: var(--color-stone-950);
    border-bottom: 1px solid var(--color-stone-700);
    padding: 1.5rem;
  }
  .stats-inner {
    max-width: 52rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }
  .stat-number {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--color-gold-400);
    font-weight: 700;
  }
  .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-parchment);
    opacity: 0.5;
  }
  .stat-divider {
    width: 1px;
    height: 2rem;
    background-color: var(--color-stone-700);
  }
  .recent-section {
    padding-block: 3rem;
  }
</style>
