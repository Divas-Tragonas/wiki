---
/* Tauler de missions: una pàgina a pantalla completa, sense el layout del wiki. El codi és a src/missions/;
   les dades (data.json, xifrades) són a public/missions/ perquè el mode DM les hi desa amb l'API de GitHub. */
import { getEntry } from 'astro:content';
import { TOWNS } from '../../missions/towns.js';
import { routes, SITE_NAME, url } from '../../lib/site';
import antiqFont from '../../missions/assets/antiq.woff2?url';
import antiqScribeFont from '../../missions/assets/antiq-scribe.woff2?url';
import '../../missions/app.css';

/* els enllaços «Més a la wiki» de les fitxes dels llocs han d'apuntar a pàgines que existeixen */
for (const town of Object.values(TOWNS)) {
  for (const [id, info] of Object.entries(town.info) as [string, { character?: string; place?: string }][]) {
    const ref = info.character ? (['characters', info.character] as const) : info.place ? (['places', info.place] as const) : null;
    if (ref && !(await getEntry(ref[0], ref[1]))) {
      throw new Error(`Tauler de missions (${town.name}, lloc «${id}»): no hi ha cap pàgina ${ref[0]}/${ref[1]} al wiki`);
    }
  }
}
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Missions — {SITE_NAME}</title>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,500;0,700;1,400&display=swap" />
    <link rel="preload" href={antiqFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={antiqScribeFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div id="stage">
      <div id="shell">
        <div class="board"></div>
        <div class="bmap" id="bmap" hidden>
          <img id="mapImg" alt="" draggable="false" />
          <svg id="labels" preserveAspectRatio="none" aria-hidden="true"></svg>
        </div>
        <div id="docs"></div>
        <div class="pile" id="pile" hidden>
          <div class="pl p3"></div>
          <div class="pl p2"></div>
          <div class="pl p1">
            <div class="pile-k">Arxiu</div>
            <div class="pile-n" id="pileN">0</div>
            <div class="pile-t">Missions completades</div>
            <div class="pile-st">Fetes</div>
          </div>
        </div>
        <div class="dim" id="dim"></div>
        <div class="pcard" id="pcard"></div>
        <div class="vig"></div>
        <div class="gobo"></div>
        <div class="gobo g2"></div>
        <canvas class="gobo-gl" id="goboGL" width="480" height="270"></canvas>
        <div class="rhandle" id="rhandle" title="Arrossega per girar">↻</div>
        <aside class="dmcard" id="dmcard"></aside>
        <div class="zp" id="zp"></div>
        <div class="hint" id="hint" hidden></div>
        <div class="dmbar" id="dmbar" hidden></div>
        <nav class="chrome" id="chrome">
          <a class="pill" href={routes.home}>← Wiki</a>
          <button class="pill" id="fxBtn" type="button" title="Canvia la llum (tecla L)">Llum: suau</button>
          <button class="pill" id="fsBtn" type="button">Pantalla completa</button>
          <button class="pill" id="dmBtn" type="button">Mode DM</button>
        </nav>
        <div class="toast" id="toast"></div>
        <div class="gate" id="gate" hidden></div>
      </div>
    </div>
    <input type="file" id="impFile" accept="application/json,.json" hidden />
    <script>
      import '../../missions/main.js';
    </script>
  </body>
</html>
