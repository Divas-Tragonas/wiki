---
import { routes, SITE_NAME } from '../lib/site';

const sense = (p: string) => p.replace(/\/$/, '');
const pathname = sense(Astro.url.pathname);
const isActive = (href: string) => pathname === sense(href) || pathname.startsWith(sense(href) + '/');
const links = [
  { href: routes.wiki, label: 'Wiki' },
  { href: routes.croniques, label: 'Cròniques' },
  { href: routes.frases, label: 'Frases' },
];
---

<nav class="navbar">
  <div class="inner">
    <a href={routes.home} class="brand">
      <span class="brand-icon" aria-hidden="true">⚔</span>
      <span>{SITE_NAME}</span>
    </a>
    <div class="links">
      {links.map(({ href, label }) => (
        <a href={href} class:list={['link', { active: isActive(href) }]} aria-current={isActive(href) ? 'page' : undefined}>
          {label}
        </a>
      ))}
      <a href={routes.missions} class="link">Missions</a>
      <button type="button" class="link search-btn" data-search-open title="Cerca (Ctrl+K)" aria-label="Cerca">🔍<span class="search-label"> Cerca</span></button>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background-color: var(--color-stone-950);
    border-bottom: 1px solid var(--color-stone-700);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-gold-400);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .brand-icon {
    font-size: 1.25rem;
  }
  .links {
    display: flex;
    gap: 2rem;
  }
  .link {
    text-decoration: none;
    color: var(--color-parchment);
    opacity: 0.7;
    font-size: 0.95rem;
    transition: color 0.2s, opacity 0.2s;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .link:hover,
  .link.active {
    color: var(--color-gold-400);
    opacity: 1;
  }
  .link.active {
    border-bottom: 2px solid var(--color-gold-500);
    padding-bottom: 2px;
  }
  .search-btn {
    background: transparent;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .inner {
      padding: 0 1rem;
      gap: 1rem;
    }
    .brand {
      font-size: 1rem;
      line-height: 1.2;
    }
    .links {
      gap: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .inner {
      height: auto;
      padding: 0.65rem 1rem;
      flex-wrap: wrap;
    }
    .brand {
      font-size: 0.95rem;
    }
    .links {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 400px) {
    .links {
      gap: 0.75rem;
      justify-content: space-between;
    }
    .search-label {
      display: none;
    }
  }
</style>
