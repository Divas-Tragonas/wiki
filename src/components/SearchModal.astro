---
---

<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Cerca">
    <div class="search-box">
      <span class="search-icon" aria-hidden="true">🔍</span>
      <input
        type="search"
        id="search-input"
        placeholder="Escriu una paraula clau… (p. ex. Kanrón, hidromel, Vaina Roja)"
        autocomplete="off"
      />
      <button type="button" class="search-close" id="search-close" aria-label="Tanca la cerca">✕</button>
    </div>
    <p class="search-status" id="search-status" aria-live="polite"></p>
    <div class="search-results" id="search-results"></div>
  </div>
</div>

<script>
  interface Item {
    title: string;
    description: string;
    section: string;
    url: string;
    tags: string[];
    extra: string;
    body: string;
  }
  interface Indexed extends Item {
    nTitle: string;
    nDesc: string;
    nTags: string;
    nExtra: string;
    nBody: string;
  }

  const overlay = document.getElementById('search-overlay')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const statusEl = document.getElementById('search-status')!;
  const resultsEl = document.getElementById('search-results')!;

  // Minúscules i sense accents perquè "canro" trobi "Kanrón". Cada caràcter es normalitza per separat i conserva
  // la llargada de l'original, així les posicions trobades al text normalitzat serveixen per marcar l'original.
  const fold = (s: string) =>
    s.replace(/[^]/gu, (ch) => {
      const n = ch.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      return n.length === ch.length ? n : ch;
    });

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function countOf(haystack: string, needle: string, max: number): number {
    let count = 0;
    for (let i = haystack.indexOf(needle); i !== -1 && count < max; i = haystack.indexOf(needle, i + needle.length)) count++;
    return count;
  }

  // Marca les coincidències dins d'un text, ignorant accents i majúscules.
  function highlight(text: string, tokens: string[]): string {
    const nText = fold(text);
    const ranges: [number, number][] = [];
    for (const t of tokens) {
      for (let i = nText.indexOf(t); i !== -1; i = nText.indexOf(t, i + t.length)) ranges.push([i, i + t.length]);
    }
    if (!ranges.length) return esc(text);
    ranges.sort((a, b) => a[0] - b[0]);
    let out = '';
    let pos = 0;
    for (const [s, e] of ranges) {
      if (e <= pos) continue;
      const from = Math.max(s, pos);
      out += esc(text.slice(pos, from)) + '<mark>' + esc(text.slice(from, e)) + '</mark>';
      pos = e;
    }
    return out + esc(text.slice(pos));
  }

  // Fragment del cos al voltant de la primera coincidència.
  function snippet(item: Indexed, tokens: string[]): string {
    const hits = tokens.map((t) => item.nBody.indexOf(t)).filter((i) => i !== -1);
    if (!hits.length) return highlight(item.description, tokens);
    const idx = Math.min(...hits);
    const start = Math.max(0, idx - 60);
    const end = Math.min(item.body.length, idx + 140);
    const text = (start > 0 ? '…' : '') + item.body.slice(start, end).trim() + (end < item.body.length ? '…' : '');
    return highlight(text, tokens);
  }

  function score(item: Indexed, tokens: string[]): number {
    let total = 0;
    for (const t of tokens) {
      let s = 0;
      if (item.nTitle === t) s += 30;
      else if (item.nTitle.startsWith(t)) s += 16;
      else if (item.nTitle.includes(t)) s += 12;
      if (item.nTags.includes(t)) s += 8;
      if (item.nExtra.includes(t)) s += 6;
      if (item.nDesc.includes(t)) s += 4;
      const inBody = countOf(item.nBody, t, 5);
      if (inBody) s += 1 + inBody;
      if (s === 0) return 0; // cada paraula ha d'aparèixer en algun camp
      total += s;
    }
    return total;
  }

  let index: Promise<Indexed[]> | null = null;
  function loadIndex(): Promise<Indexed[]> {
    index ??= fetch(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/cerca.json`)
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json() as Promise<Item[]>;
      })
      .then((data) =>
        data.map((it) => ({
          ...it,
          nTitle: fold(it.title),
          nDesc: fold(it.description),
          nTags: fold(it.tags.join(' ')),
          nExtra: fold(it.extra),
          nBody: fold(it.body),
        })),
      )
      .catch((err) => {
        index = null; // es tornarà a provar a la propera cerca
        throw err;
      });
    return index;
  }

  function renderResult(item: Indexed, tokens: string[]): string {
    const tags = item.tags.length
      ? `<div class="result-tags">${item.tags
          .slice(0, 4)
          .map((tag) => `<span class="result-tag">${highlight(tag, tokens)}</span>`)
          .join('')}</div>`
      : '';
    return `
      <a href="${esc(item.url)}" class="result-card">
        <div class="result-top">
          <span class="result-title">${highlight(item.title, tokens)}</span>
          <span class="result-section">${esc(item.section)}</span>
        </div>
        <p class="result-snippet">${snippet(item, tokens)}</p>
        ${tags}
      </a>`;
  }

  async function search(query: string) {
    const tokens = fold(query).split(/\s+/).filter((t) => t.length >= 2);
    if (!tokens.length) {
      statusEl.textContent = '';
      resultsEl.innerHTML = '';
      return;
    }
    let items: Indexed[];
    try {
      items = await loadIndex();
    } catch {
      statusEl.textContent = "No s'ha pogut carregar l'índex de cerca. Torna-ho a provar.";
      resultsEl.innerHTML = '';
      return;
    }
    if (query !== input.value) return; // ja s'ha escrit una altra cosa
    const results = items
      .map((item) => ({ item, s: score(item, tokens) }))
      .filter((r) => r.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 50);

    const q = query.trim();
    statusEl.textContent = results.length
      ? `${results.length} resultat${results.length === 1 ? '' : 's'} per a «${q}»`
      : `Cap resultat per a «${q}»`;
    resultsEl.innerHTML = results.map(({ item }) => renderResult(item, tokens)).join('');
  }

  let opener: Element | null = null;

  function openSearch() {
    opener = document.activeElement;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    loadIndex().catch(() => {});
    input.focus();
    input.select();
  }

  function closeSearch() {
    overlay.hidden = true;
    document.body.style.overflow = '';
    if (opener instanceof HTMLElement) opener.focus();
  }

  document.querySelectorAll('[data-search-open]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openSearch();
    });
  });

  document.getElementById('search-close')!.addEventListener('click', closeSearch);

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeSearch();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.hidden) closeSearch();
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (overlay.hidden) openSearch();
      else closeSearch();
    }
  });

  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => search(input.value), 150);
  });
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background-color: rgba(5, 6, 9, 0.75);
    backdrop-filter: blur(3px);
    padding: 10vh 1rem 1rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .search-panel {
    width: 100%;
    max-width: 42rem;
    max-height: 78vh;
    display: flex;
    flex-direction: column;
    background-color: #0f1218;
    border: 1px solid #2f3542;
    border-radius: 0.75rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-stone-700);
    flex-shrink: 0;
  }
  .search-icon {
    opacity: 0.6;
  }
  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #e8e2ce;
    font-size: 1rem;
    font-family: var(--font-body);
  }
  #search-input::placeholder {
    color: var(--color-parchment);
    opacity: 0.35;
  }
  .search-close {
    background: transparent;
    border: none;
    color: var(--color-parchment);
    opacity: 0.5;
    font-size: 0.9rem;
    cursor: pointer;
    padding: 0.25rem 0.4rem;
    border-radius: 0.25rem;
    transition: opacity 0.2s, background-color 0.2s;
  }
  .search-close:hover {
    opacity: 1;
    background-color: rgba(212, 201, 168, 0.1);
  }
  .search-status {
    color: var(--color-parchment);
    opacity: 0.6;
    font-size: 0.8rem;
    margin: 0;
    padding: 0.6rem 1rem 0;
    flex-shrink: 0;
  }
  .search-status:empty {
    display: none;
  }
  .search-results {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.75rem 1rem 1rem;
  }
  .search-results:empty {
    padding: 0;
  }
  .search-results :global(.result-card) {
    display: block;
    background-color: #12151c;
    border: 1px solid var(--color-stone-700);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .search-results :global(.result-card:hover) {
    border-color: var(--color-gold-500);
    background-color: #151923;
  }
  .search-results :global(.result-top) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.3rem;
  }
  .search-results :global(.result-title) {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-gold-400);
  }
  .search-results :global(.result-section) {
    flex-shrink: 0;
    background-color: var(--gold-tint);
    color: var(--color-gold-500);
    border: 1px solid var(--gold-line);
    border-radius: 9999px;
    font-size: 0.7rem;
    padding: 0.1rem 0.55rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .search-results :global(.result-snippet) {
    color: var(--color-parchment);
    opacity: 0.75;
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }
  .search-results :global(.result-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }
  .search-results :global(.result-tag) {
    background-color: rgba(212, 201, 168, 0.08);
    color: var(--color-parchment);
    opacity: 0.7;
    border-radius: 9999px;
    font-size: 0.7rem;
    padding: 0.1rem 0.5rem;
  }
  .search-results :global(mark) {
    background-color: rgba(201, 168, 76, 0.35);
    color: #f5e6b8;
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
