---
import { SITE_NAME } from '../lib/site';
---

<footer class="footer">
  <p class="text">{SITE_NAME} &mdash; Wiki de campanya D&amp;D</p>
  <p class="sub">Divas y Tragonas<sup class="reg">®</sup></p>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    border-top: 1px solid var(--color-stone-700);
    padding: 2rem 1.5rem;
    background-color: var(--color-stone-950);
    text-align: center;
  }
  .text {
    font-family: var(--font-display);
    color: var(--color-gold-500);
    font-size: 0.9rem;
    margin: 0 0 0.25rem 0;
  }
  .sub {
    color: var(--color-parchment);
    opacity: 0.4;
    font-size: 0.8rem;
    margin: 0;
  }
  .reg {
    font-size: 0.55em;
    vertical-align: super;
    margin-left: 1px;
  }
</style>
