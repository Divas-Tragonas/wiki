---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TagBadge from '../components/TagBadge.astro';
import { url } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  breadcrumbs: { label: string; href?: string }[];
  metadata?: { label: string; value: string; href?: string }[];
  tags?: string[];
  /* mostra la imatge (o la inicial si no n'hi ha) a la columna lateral */
  showImage?: boolean;
  image?: string;
}

const { title, description, breadcrumbs, metadata = [], tags = [], showImage = false, image } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="page">
    <Breadcrumb items={breadcrumbs} />

    <div class="entry-layout">
      <article>
        <h1 class="entry-title">{title}</h1>
        {description && <p class="entry-desc">{description}</p>}
        <div class="prose">
          <slot />
        </div>
      </article>

      <aside class="entry-sidebar">
        {showImage && (
          <div class="sidebar-card image-card">
            {image ? (
              <img src={url(image)} alt={title} class="entry-image" />
            ) : (
              <div class="entry-image-placeholder" aria-hidden="true">
                <span class="placeholder-initial">{title.charAt(0)}</span>
              </div>
            )}
          </div>
        )}
        {metadata.length > 0 && (
          <div class="sidebar-card">
            <h2 class="sidebar-title">Informació</h2>
            <dl class="meta-list">
              {metadata.map((item) => (
                <>
                  <dt class="meta-label">{item.label}</dt>
                  <dd class="meta-value">{item.href ? <a href={item.href} target="_blank" rel="noopener">{item.value}</a> : item.value}</dd>
                </>
              ))}
            </dl>
          </div>
        )}
        {tags.length > 0 && (
          <div class="sidebar-card">
            <h2 class="sidebar-title">Etiquetes</h2>
            <div class="tags-list">
              {tags.map((tag) => <TagBadge tag={tag} />)}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .entry-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 768px) {
    .entry-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .entry-sidebar {
      order: -1;
    }
  }
  .entry-title {
    font-size: 2rem;
    color: var(--color-gold-400);
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }
  .entry-desc {
    color: var(--color-parchment);
    opacity: 0.7;
    font-size: 1.05rem;
    margin: 0 0 1.5rem 0;
    line-height: 1.6;
    border-left: 3px solid var(--color-gold-500);
    padding-left: 1rem;
  }
  .sidebar-card {
    background-color: var(--color-stone-800);
    border: 1px solid var(--color-stone-700);
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .sidebar-title {
    font-size: 0.8rem;
    color: var(--color-gold-500);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.75rem 0;
  }
  .meta-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }
  .meta-label {
    color: var(--color-parchment);
    opacity: 0.6;
  }
  .meta-value {
    color: var(--color-parchment);
  }
  .meta-value a {
    color: var(--color-gold-500);
  }
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .image-card {
    padding: 0;
    overflow: hidden;
  }
  .entry-image,
  .entry-image-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1;
  }
  .entry-image {
    object-fit: cover;
  }
  .entry-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #14161c;
  }
  .placeholder-initial {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--color-gold-500);
    opacity: 0.35;
  }
</style>
