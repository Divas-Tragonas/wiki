<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Només si el sistema d'autofetch no pot executar un script després de cada actualització: mira cada 5 minuts si el
     repositori té una versió nova de l'API (update.sh no fa res si no n'hi ha). Substitueix __HOME__, __REPO__ i
     __NODE_DIR__ i copia'l a ~/Library/LaunchAgents/cat.divasytragonas.missions-update.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>cat.divasytragonas.missions-update</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO__/deploy/macmini/update.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__NODE_DIR__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>__HOME__/missions-api/logs/update.log</string>
  <key>StandardErrorPath</key><string>__HOME__/missions-api/logs/update.log</string>
</dict>
</plist>
