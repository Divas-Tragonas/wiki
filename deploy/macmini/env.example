# Configuració de l'API de missions a la Mac mini. Copia'l a ~/missions-api/.env (no va al repositori).

# Postgres de la Mac mini: base de dades i usuari propis
DATABASE_URL=postgres://missions:CANVIA-AIXO@127.0.0.1:5432/missions

# només escolta a la mateixa màquina: des de fora s'hi arriba pel túnel
HOST=127.0.0.1
PORT=8787

# d'on es pot fer servir l'API: l'adreça del wiki (Vercel, GitHub Pages…), separades per comes
ALLOWED_ORIGINS=https://divas-tragonas.github.io

# 1 si les peticions arriben per Cloudflare (la IP real ve a CF-Connecting-IP)
TRUST_PROXY=0

LOG_REQUESTS=1

# opcional: on copiar les còpies de cada nit fora de la Mac mini (un remot de rclone)
# RCLONE_REMOTE=r2:missions-backups
