<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Servei de l'API de missions (LaunchAgent de l'usuari del servidor). Substitueix __HOME__ i __NODE_DIR__ i copia'l a
     ~/Library/LaunchAgents/cat.divasytragonas.missions-api.plist; després:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/cat.divasytragonas.missions-api.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>cat.divasytragonas.missions-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>set -a; . "__HOME__/missions-api/.env"; set +a; exec node "__HOME__/missions-api/current/api/dist/server.js"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__NODE_DIR__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/missions-api/logs/api.log</string>
  <key>StandardErrorPath</key><string>__HOME__/missions-api/logs/api.log</string>
</dict>
</plist>
